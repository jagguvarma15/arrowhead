# Copy to .env for local development. Every variable takes the ARROWHEAD_
# prefix. Values here are safe placeholders, not real secrets.

# --- Profile ---
# Which tool families this deployment exposes: core, docs, coding, or full.
# A tool outside the active profile is never registered, so it costs no
# context and a call to it is unknown. The exec family is gated a second time
# behind ARROWHEAD_EXEC_ENABLED even under coding or full.
ARROWHEAD_PROFILE=full

# --- Transport ---
# stdio for Inspector over a pipe; http to serve the streamable endpoint.
ARROWHEAD_TRANSPORT=stdio
ARROWHEAD_HOST=127.0.0.1
ARROWHEAD_PORT=8000
ARROWHEAD_STATELESS_HTTP=true
# Comma-separated Host and Origin allowlists for the HTTP endpoint. Set
# these to your public hostname when deploying behind a proxy.
ARROWHEAD_ALLOWED_HOSTS=
ARROWHEAD_ALLOWED_ORIGINS=

# --- Auth (OAuth 2.1 resource server) ---
# Leave disabled only for local stdio development. The server's public URL
# is always required when enabled.
ARROWHEAD_AUTH_ENABLED=false
# Serving HTTP with auth disabled exposes every tool with no check; the server
# refuses to start that way unless this is set for a trusted-network test.
ARROWHEAD_ALLOW_INSECURE_HTTP=false
ARROWHEAD_SERVER_PUBLIC_URL=https://arrowhead.example.com
# "jwt" verifies against any OAuth 2.1 issuer (bring-your-own-IdP, e.g.
# Keycloak); "workos" wires WorkOS AuthKit, purpose-built for MCP.
ARROWHEAD_OAUTH_PROVIDER=jwt

# jwt provider: issuer, audience (= the canonical resource URI, must equal
# SERVER_PUBLIC_URL's resource), and one key source (JWKS URI preferred).
ARROWHEAD_OAUTH_ISSUER=https://your-idp.example.com
ARROWHEAD_OAUTH_AUDIENCE=https://arrowhead.example.com
ARROWHEAD_OAUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# ARROWHEAD_OAUTH_PUBLIC_KEY=

# workos provider: the AuthKit domain from the WorkOS dashboard. AuthKit
# serves the OAuth metadata MCP clients need for automatic registration.
# ARROWHEAD_OAUTH_AUTHKIT_DOMAIN=https://your-project.authkit.app

# --- Per-resource authorization (document tools) ---
# JSON policy applied on top of scopes. Empty uses a safe default: any
# authenticated caller may search, read, and scan the corpus, but write
# only within its own "<subject>/" namespace. Ignored when auth is off.
# Example:
# ARROWHEAD_AUTHZ_POLICY={"grants":[{"subject":"*","actions":["read","search","scan"],"prefix":""},{"subject":"*","actions":["write"],"prefix":"${subject}/"}]}
ARROWHEAD_AUTHZ_POLICY=

# --- read_file jail ---
# The only directory read_file may read from.
ARROWHEAD_JAIL_ROOT=sandbox
ARROWHEAD_READ_FILE_MAX_BYTES=1000000

# --- Document corpus (doc_* tools) ---
# The jailed root the document tools operate on, separate from the
# read-only read_file sandbox. Only these extensions are documents.
ARROWHEAD_DOCS_ROOT=documents
ARROWHEAD_DOC_MAX_BYTES=1000000
ARROWHEAD_DOC_ALLOWED_EXTENSIONS=.json,.md,.txt
# Content hardening caps applied to returned document content.
ARROWHEAD_CONTENT_MAX_BYTES=1000000
ARROWHEAD_JSON_MAX_DEPTH=64
ARROWHEAD_JSON_MAX_ELEMENTS=100000

# --- doc_search ---
# Regex is off by default (denial-of-service surface); when enabled it
# runs through a ReDoS-resistant engine with a hard timeout.
ARROWHEAD_SEARCH_QUERY_MAX_LENGTH=200
ARROWHEAD_SEARCH_REGEX_ENABLED=false
ARROWHEAD_SEARCH_REGEX_TIMEOUT_MS=250
ARROWHEAD_SEARCH_MAX_FILES=2000
ARROWHEAD_SEARCH_MAX_RESULTS=50
ARROWHEAD_SEARCH_MAX_TOTAL_BYTES=200000
ARROWHEAD_SEARCH_SNIPPET_MAX_CHARS=200

# --- doc_scan ---
ARROWHEAD_SCAN_MAX_FILES=2000
ARROWHEAD_SCAN_PER_FILE_MAX_BYTES=1000000
ARROWHEAD_SCAN_TIMEOUT_SECONDS=10
ARROWHEAD_SCAN_MAX_FINDINGS=200

# --- doc_write ---
ARROWHEAD_DOC_WRITE_MAX_BYTES=1000000
ARROWHEAD_DOC_WRITE_QUOTA_BYTES=50000000
# Overwriting asks for confirmation via elicitation; when the client
# cannot elicit, the explicit overwrite flag stands in as the opt-in.
ARROWHEAD_REQUIRE_WRITE_CONFIRMATION=true

# --- safe_fetch ---
ARROWHEAD_FETCH_TIMEOUT_SECONDS=10
ARROWHEAD_FETCH_MAX_RESPONSE_BYTES=1000000
ARROWHEAD_FETCH_MAX_REDIRECTS=3

# --- Egress allowlist (safe_fetch, doc_retrieve) ---
# Comma-separated hostnames the fetch and retrieve tools may reach, enforced
# on every redirect hop. Empty allows any public host; the SSRF guard blocks
# private ranges regardless. Set this to restrict outbound requests to
# approved destinations.
ARROWHEAD_EGRESS_ALLOWED_HOSTS=
# Extra ports permitted beyond 80 and 443 (comma-separated). Empty allows
# only the two web ports, so a public host cannot be used to reach an
# internal service on a non-web port.
ARROWHEAD_EGRESS_ALLOWED_PORTS=

# --- calculate ---
ARROWHEAD_EXPRESSION_MAX_LENGTH=200

# --- SQL connector (sql extra) ---
# The read tool runs a single vetted read-only statement against this
# database. The DSN is a SQLAlchemy async URL. Empty leaves the connector
# unconfigured and the tool refuses to run. A read-only database role is the
# recommended credential; the connector also runs each query in a read-only
# transaction under a server-side statement timeout where supported.
# ARROWHEAD_SQL_DSN=postgresql+asyncpg://readonly@db.example.com/app
ARROWHEAD_SQL_DSN=
# The dialect the guard parses against; empty infers it from the DSN driver.
ARROWHEAD_SQL_DIALECT=
ARROWHEAD_SQL_QUERY_MAX_LENGTH=2000
ARROWHEAD_SQL_MAX_ROWS=1000
ARROWHEAD_SQL_MAX_BYTES=1000000
ARROWHEAD_SQL_MAX_COLUMNS=100
ARROWHEAD_SQL_TIMEOUT_SECONDS=10

# --- pgvector search (postgres extra), over the SQL DSN database ---
# Only these collections (comma-separated table names) may be searched, and
# the tenant filter is the authenticated caller, never an argument. Empty
# leaves the search tool unconfigured. The column names default to a common
# convention and are overridable per deployment.
ARROWHEAD_PGVECTOR_COLLECTIONS=
ARROWHEAD_PGVECTOR_TENANT_COLUMN=tenant
ARROWHEAD_PGVECTOR_ID_COLUMN=id
ARROWHEAD_PGVECTOR_CONTENT_COLUMN=content
ARROWHEAD_PGVECTOR_EMBEDDING_COLUMN=embedding
# Provenance columns written by doc_index and returned by vector_query so a
# retrieved chunk carries its source document and position as a citation.
ARROWHEAD_PGVECTOR_SOURCE_COLUMN=source
ARROWHEAD_PGVECTOR_CHUNK_INDEX_COLUMN=chunk_index
# content_hash powers diff-aware re-indexing; content_tsv powers the full-text
# branch of hybrid_query. Both are added by deploy/pgvector_schema.sql.
ARROWHEAD_PGVECTOR_CONTENT_HASH_COLUMN=content_hash
ARROWHEAD_PGVECTOR_TSVECTOR_COLUMN=content_tsv
ARROWHEAD_PGVECTOR_MAX_K=50
ARROWHEAD_PGVECTOR_MAX_DIMENSIONS=2000

# --- Embeddings (used by doc_index and vector_query) ---
# "deterministic" is a stdlib, offline, non-semantic provider for tests and
# local development. "http" posts to an OpenAI-compatible endpoint through the
# SSRF guard; the endpoint host must be on the egress allowlist and the key is
# supplied here, never forwarded to any other host.
ARROWHEAD_EMBEDDING_PROVIDER=deterministic
ARROWHEAD_EMBEDDING_DIMENSIONS=1536
ARROWHEAD_EMBEDDING_ENDPOINT=
ARROWHEAD_EMBEDDING_MODEL=
ARROWHEAD_EMBEDDING_API_KEY=
ARROWHEAD_EMBEDDING_BATCH_SIZE=64
ARROWHEAD_EMBEDDING_TIMEOUT_SECONDS=30
ARROWHEAD_EMBEDDING_MAX_TEXTS=10000

# --- Vector ingestion (doc_index) ---
# Writing chunks needs a write-capable credential, kept separate from the
# read-only SQL DSN so the read tools stay least privilege; ingestion refuses
# to run until it is set. The caps bound how much one call may index.
ARROWHEAD_VECTOR_WRITE_DSN=
ARROWHEAD_VECTOR_INDEX_MAX_FILES=500
ARROWHEAD_VECTOR_INDEX_MAX_CHUNKS=5000
ARROWHEAD_VECTOR_INDEX_CHUNK_MAX_CHARS=1500
ARROWHEAD_VECTOR_INDEX_CHUNK_OVERLAP=200
ARROWHEAD_VECTOR_INDEX_TIMEOUT_SECONDS=30
# Source files chunk along their structure with this wider window. A re-index
# re-embeds only chunks whose content hash changed; set reuse false to restore
# the wholesale delete-and-insert on a schema without the content_hash column.
ARROWHEAD_CODE_CHUNK_MAX_CHARS=2000
ARROWHEAD_INDEX_REUSE_UNCHANGED=true

# --- Hybrid retrieval (hybrid_query) ---
# Fuses vector similarity with Postgres full-text rank by reciprocal rank
# fusion. The candidate multiplier sizes each branch's pool as a multiple of k.
# The text search configuration must name an installed Postgres regconfig.
ARROWHEAD_HYBRID_RRF_K=60
ARROWHEAD_HYBRID_CANDIDATE_MULTIPLIER=4
ARROWHEAD_FTS_LANGUAGE=english

# --- Repo intelligence (repo family) ---
# The code tools read a jailed source tree, separate from the document corpus:
# read-only, with version-control and dependency directories pruned, binary
# files refused, and per-file and per-walk caps.
ARROWHEAD_REPO_ROOT=repo
ARROWHEAD_REPO_MAX_FILE_BYTES=500000
# ARROWHEAD_REPO_ALLOWED_EXTENSIONS=.c,.cpp,.cs,.go,.h,.hpp,.java,.js,.json,.jsx,.kt,.md,.php,.py,.pyi,.rb,.rs,.scala,.sh,.sql,.swift,.toml,.ts,.tsx,.txt,.yaml,.yml
# ARROWHEAD_REPO_EXCLUDED_DIRS=.git,.hg,.svn,.venv,node_modules,__pycache__,dist,build,target
ARROWHEAD_REPO_SEARCH_MAX_FILES=5000
ARROWHEAD_SYMBOL_MAP_MAX_FILES=500
ARROWHEAD_SYMBOL_MAP_MAX_SYMBOLS=5000
ARROWHEAD_DEPENDENCY_GRAPH_MAX_FILES=500

# --- Completion backend (assist family) ---
# "none" keeps the assist tools refusing. "anthropic" posts to the Anthropic
# Messages API; "openai" posts to any OpenAI-compatible chat-completions URL,
# which covers Ollama, vLLM, and LM Studio. The key is supplied here and never
# appears in an error. A local endpoint must be named in
# ARROWHEAD_LLM_INTERNAL_HOSTS (exact host:port pairs) to be reachable.
ARROWHEAD_LLM_PROVIDER=none
ARROWHEAD_LLM_ENDPOINT=
ARROWHEAD_LLM_MODEL=
ARROWHEAD_LLM_API_KEY=
ARROWHEAD_LLM_MAX_TOKENS=1024
ARROWHEAD_LLM_TIMEOUT_SECONDS=60
ARROWHEAD_LLM_MAX_PROMPT_CHARS=32000
ARROWHEAD_LLM_INTERNAL_HOSTS=
ARROWHEAD_DIFF_MAX_BYTES=200000

# --- Sandboxed execution (exec family) ---
# Off by default and, even when enabled, denied by the default policy: a
# deployment opts in twice, by this flag and by granting the execute action.
# The subprocess runner bounds resources and scrubs the environment but does
# not block network or filesystem reads; use the container runner for that.
ARROWHEAD_EXEC_ENABLED=false
ARROWHEAD_EXEC_RUNNER=subprocess
ARROWHEAD_EXEC_CONTAINER_IMAGE=
ARROWHEAD_EXEC_WORKDIR=exec-scratch
ARROWHEAD_EXEC_CPU_SECONDS=10
ARROWHEAD_EXEC_WALL_SECONDS=30
ARROWHEAD_EXEC_TEST_WALL_SECONDS=120
ARROWHEAD_EXEC_MEMORY_BYTES=512000000
ARROWHEAD_EXEC_MAX_OUTPUT_BYTES=200000
ARROWHEAD_EXEC_MAX_CODE_BYTES=100000
ARROWHEAD_EXEC_MAX_COPY_BYTES=50000000
ARROWHEAD_EXEC_COPY_MAX_FILES=500
# The argv run_tests executes inside the scratch copy, shell-split; empty
# refuses run_tests.
ARROWHEAD_EXEC_TEST_COMMAND=

# --- Working sets and context packer (context family) ---
# A working set is a named, owner-scoped collection of pinned references; the
# packer assembles a token-budgeted, secret-scanned bundle from it plus
# retrieval. Bounds keep one caller from growing state without limit.
ARROWHEAD_WORKINGSET_MAX_SETS=100
ARROWHEAD_WORKINGSET_MAX_ITEMS=200
ARROWHEAD_PACK_MAX_TOKENS=8000

# --- Abuse controls ---
# Ceilings are calls per caller per minute. Redis, if set, shares the
# buckets across replicas; without it limits apply per process.
ARROWHEAD_RATE_LIMIT_ENABLED=true
ARROWHEAD_SAFE_FETCH_PER_MINUTE=30
ARROWHEAD_CALCULATE_PER_MINUTE=120
ARROWHEAD_READ_FILE_PER_MINUTE=60
ARROWHEAD_DOC_SEARCH_PER_MINUTE=60
ARROWHEAD_DOC_READ_PER_MINUTE=60
ARROWHEAD_DOC_RETRIEVE_PER_MINUTE=30
ARROWHEAD_DOC_SCAN_PER_MINUTE=20
ARROWHEAD_DOC_WRITE_PER_MINUTE=30
ARROWHEAD_SQL_QUERY_PER_MINUTE=60
ARROWHEAD_VECTOR_SEARCH_PER_MINUTE=30
ARROWHEAD_VECTOR_QUERY_PER_MINUTE=30
ARROWHEAD_HYBRID_QUERY_PER_MINUTE=30
ARROWHEAD_VECTOR_INDEX_PER_MINUTE=6
ARROWHEAD_CODE_SEARCH_PER_MINUTE=60
ARROWHEAD_CODE_READ_PER_MINUTE=60
ARROWHEAD_SYMBOL_MAP_PER_MINUTE=20
ARROWHEAD_DEPENDENCY_GRAPH_PER_MINUTE=10
ARROWHEAD_CODE_EXPLAIN_PER_MINUTE=10
ARROWHEAD_SUMMARIZE_DIFF_PER_MINUTE=10
ARROWHEAD_RERANK_PER_MINUTE=20
ARROWHEAD_RUN_SNIPPET_PER_MINUTE=10
ARROWHEAD_RUN_TESTS_PER_MINUTE=4
ARROWHEAD_WORKINGSET_GET_PER_MINUTE=60
ARROWHEAD_WORKINGSET_UPDATE_PER_MINUTE=30
ARROWHEAD_PACK_CONTEXT_PER_MINUTE=10
# Starting an async task is expensive (a background scan); polling is cheap.
ARROWHEAD_TASK_START_PER_MINUTE=10
ARROWHEAD_TASK_GET_PER_MINUTE=120
ARROWHEAD_TASK_UPDATE_PER_MINUTE=30
# Reading a resource, getting a prompt, and completing an argument are
# rate-limited per caller too.
ARROWHEAD_RESOURCE_READ_PER_MINUTE=60
ARROWHEAD_PROMPT_GET_PER_MINUTE=60
ARROWHEAD_COMPLETION_PER_MINUTE=60
# Any tool without an explicit ceiling above falls back to this default.
ARROWHEAD_DEFAULT_TOOL_PER_MINUTE=60
ARROWHEAD_REDIS_URL=redis://localhost:6379/0

# --- Kill switch ---
# Comma-separated tool names to take out of service without a redeploy.
ARROWHEAD_DISABLED_TOOLS=

# --- Cache hints ---
# How long clients may cache a list result and a single resource read; both
# ride in the result _meta with a private cache scope.
ARROWHEAD_TOOL_LIST_TTL_MS=3600000
ARROWHEAD_RESOURCE_READ_TTL_MS=60000

# --- Observability (OpenTelemetry) ---
# Set the OTLP/HTTP collector base endpoint to export traces and metrics;
# leave empty and both stay no-op at no cost. Headers are comma-separated
# key=value pairs (e.g. a collector API key). Audit logs are always emitted
# as JSON on stdout for the platform's log drain regardless of this.
ARROWHEAD_OTEL_EXPORTER_OTLP_ENDPOINT=
# ARROWHEAD_OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
ARROWHEAD_OTEL_SERVICE_NAME=arrowhead
